{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site Transfer configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "target"
  ],
  "properties": {
    "version": {
      "const": 1,
      "default": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_name"
      ],
      "properties": {
        "project_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "frontend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "repository"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "chromium"
        },
        "headless": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        }
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "width",
          "height"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "width": {
            "type": "integer",
            "minimum": 240,
            "maximum": 7680
          },
          "height": {
            "type": "integer",
            "minimum": 240,
            "maximum": 7680
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "interactions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scenarios": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "route",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
              },
              "route": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^/(?!/)[^?#\\\\\\s]*$"
              },
              "action": {
                "enum": [
                  "hover",
                  "focus",
                  "click",
                  "scroll"
                ]
              },
              "selector": {
                "type": "string",
                "maxLength": 160,
                "pattern": "^(?:[.#][A-Za-z_][A-Za-z0-9_-]*|\\[data-testid=\"[A-Za-z0-9_-]+\"\\])$"
              },
              "expect_visible": {
                "type": "string",
                "maxLength": 160,
                "pattern": "^(?:[.#][A-Za-z_][A-Za-z0-9_-]*|\\[data-testid=\"[A-Za-z0-9_-]+\"\\])$"
              },
              "scroll_y": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "viewports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              },
              "wait_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1500
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "scroll"
                    }
                  }
                },
                "then": {
                  "required": [
                    "scroll_y"
                  ],
                  "not": {
                    "required": [
                      "selector"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "selector"
                  ],
                  "not": {
                    "required": [
                      "scroll_y"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "const": "en"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_review_before_push": {
          "const": true
        },
        "resume": {
          "type": "boolean"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    }
  }
}
